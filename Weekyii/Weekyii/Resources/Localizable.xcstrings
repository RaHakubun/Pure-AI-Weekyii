    "vip.features.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything else stays free forever: weekly plans and today's tasks, Strict mode, Dynamic Island and Live Activities, Home and Lock Screen widgets, data export and restore, and more."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其余功能永久免费：周计划与今日任务、严格模式、灵动岛与实时活动、桌面和锁屏小组件、数据导出与恢复等。"
          }
        }
      }
    },
