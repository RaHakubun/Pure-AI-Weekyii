    "vip.expiry.cloud" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync: paused. Nothing on this device or in iCloud is deleted or changed, and syncing resumes where it stopped when you renew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步：暂停同步。本机和 iCloud 中的数据都不会被删除或修改，续费后从暂停处继续同步。"
          }
        }
      }
    },
    "vip.expiry.flexible" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexible mode: a day already running is unaffected; days you start later use Strict mode, and your preference is kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵动模式：当天已开始的任务流不受影响；之后启动的日子使用严格模式，你的偏好会保留。"
          }
        }
      }
    },
    "vip.expiry.header" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When VIP Ends"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到期后会怎样"
          }
        }
      }
    },
    "vip.expiry.themes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIP themes: the app, widgets and Dynamic Island switch back to Amber. Your chosen theme is kept and returns when you renew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIP 主题：界面、小组件和灵动岛切回琥珀主题，你选的主题会保留，续费后自动恢复。"
          }
        }
      }
    },
    "vip.feature.cloud.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync weeks, tasks, projects and habits between your iPhone and iPad. Your data stays in your own iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的 iPhone 和 iPad 之间同步周计划、任务、项目与习惯。数据存放在你自己的 iCloud 中。"
          }
        }
      }
    },
    "vip.feature.cloud.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Sync"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同步"
          }
        }
      }
    },
    "vip.feature.flexible.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still one focus at a time, but you can unfreeze today's queue to add, edit, reorder and swap tasks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始后仍只专注一件事，但可以主动解冻今日队列，增改、排序和交换任务。"
          }
        }
      }
    },
    "vip.feature.themes.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — each with its own colors, shapes and artwork, also applied to widgets and the Dynamic Island."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，每套主题都有独立的色彩、形态与印象画，小组件和灵动岛同步生效。"
          }
        }
      }
    },
    "vip.feature.themes.title" : {
