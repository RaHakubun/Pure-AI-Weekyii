    "settings.execution.vip_expired" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIP is not active: a day already running is unaffected, and days you start later use Strict mode. Flexible mode comes back when you renew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIP 未开通或已到期：今天已开始的任务流不受影响，之后启动的日子使用严格模式。续费后自动恢复灵动模式。"
          }
        }
      }
    },
    "settings.theme.vip.footer.locked" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available with VIP. When VIP ends, the app switches back to Amber and keeps your choice, restoring it when you renew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开通 VIP 即可使用。到期后会切回琥珀主题，并保留你的选择，续费后自动恢复。"
          }
        }
      }
    },
    "settings.theme.vip.footer.unlocked" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIP themes have their own visual language, applied to widgets and the Dynamic Island too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIP 主题拥有独立的视觉语言，小组件和灵动岛同步生效。"
          }
        }
      }
    },
